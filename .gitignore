# Ignore JetBrains IDE settings (IntelliJ, WebStorm, etc.)
.idea/

# Ignore Node.js dependencies
node_modules/

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Cypress output (screenshots and videos generated during tests)
cypress/screenshots/
cypress/videos/

# Ignore system files
.DS_Store
Thumbs.db

# Optional: ignore lock files (if you want each dev to regenerate them)
# package-lock.json
# yarn.lock
